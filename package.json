{
  "name": "vaultdrop",
  "version": "1.0.0",
  "private": true,
  "description": "VaultDrop — share secrets, leave no trace.",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && bun run typecheck && bun run test",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:e2e": "playwright test",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "jobs:run": "bun scripts/run-jobs.ts",
    "loadtest": "bun scripts/loadtest.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "@electric-sql/pglite": "0.5.15",
    "@hookform/resolvers": "6.0.2",
    "@noble/hashes": "2.4.0",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "hast-util-to-jsx-runtime": "2.3.7",
    "ioredis": "6.0.0",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "nodemailer": "^10.4.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "^0.0.1",
    "shiki": "4.6.0",
    "stripe": "23.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
