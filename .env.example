# VaultDrop configuration. Copy to .env and fill in. Placeholders only — never commit real values.

# Public origin of the app (used for links, cookies, CSRF checks, WebAuthn RP ID).
APP_URL=http://localhost:3000

# --- Secrets (REQUIRED in production) -------------------------------------------------------
# Generate each with:  openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-48-random-bytes
APP_SECRET=replace-with-a-different-48-random-bytes

# --- Database -------------------------------------------------------------------------------
# PostgreSQL 15+. Leave unset in development to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=postgres://vaultdrop:vaultdrop@localhost:5432/vaultdrop
# Direct (non-pooled) URL used by `bun run db:migrate`, e.g. Neon's host without "-pooler".
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=verify-full
DATABASE_POOL_MAX=10
# PGLITE_DATA_DIR=.data/pglite

# --- Redis (optional) ------------------------------------------------------------------------
# Used for rate limiting when set; otherwise rate limits are stored in PostgreSQL.
# REDIS_URL=redis://localhost:6379

# --- Reverse proxy ----------------------------------------------------------------------------
# Set to true ONLY behind a proxy that overwrites X-Forwarded-For (nginx, Caddy, a load balancer).
# Required in production for per-client rate limiting.
TRUST_PROXY=false

# --- Email (required for sign-up, password reset, invitations) ------------------------------
# Either a single URL…
# SMTP_URL=smtps://user:password@smtp.example.com:465
# …or discrete settings (SMTP_SECURE=false means STARTTLS, which is then required):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer@example.com
# SMTP_PASS=replace-me
EMAIL_FROM="VaultDrop <no-reply@example.com>"
# EMAIL_OUTBOX_FILE=.data/outbox.log   # write emails to a file instead (testing only)

# --- Background jobs --------------------------------------------------------------------------
# true: run expiry/cleanup/webhook jobs inside the web process (single instance or any count — jobs are idempotent).
JOBS_IN_PROCESS=true
# Protects POST /api/internal/jobs for external cron triggers.  openssl rand -base64 32
# CRON_SECRET=replace-me

# --- Billing (optional) ----------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PERSONAL=price_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_TEAM=price_xxx

# --- Operations ------------------------------------------------------------------------------
# Comma-separated emails that receive the admin role when they sign up.
ADMIN_EMAILS=
LOG_LEVEL=info
SUPPORT_EMAIL=support@example.com
SECURITY_EMAIL=security@example.com
# STATUS_PAGE_URL=https://status.example.com
